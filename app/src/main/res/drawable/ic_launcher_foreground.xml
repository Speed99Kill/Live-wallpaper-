<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer phone/wallpaper canvas bezel -->
    <path
        android:pathData="M37,25 h34 a8,8 0 0 1 8,8 v42 a8,8 0 0 1 -8,8 h-34 a8,8 0 0 1 -8,-8 v-42 a8,8 0 0 1 8,-8 z"
        android:strokeWidth="2.5"
        android:strokeColor="#4A5568"
        android:fillColor="#121829" />

    <!-- Screen inner live wallpaper canvas with gradient -->
    <path
        android:pathData="M38,28 h32 a5,5 0 0 1 5,5 v38 a5,5 0 0 1 -5,5 h-32 a5,5 0 0 1 -5,-5 v-38 a5,5 0 0 1 5,-5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="28"
                android:endX="70"
                android:endY="76"
                android:type="linear">
                <item android:color="#241442" android:offset="0.0" />
                <item android:color="#1A2752" android:offset="0.5" />
                <item android:color="#0D47A1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing motion waves inside wallpaper screen -->
    <path
        android:pathData="M34,56 C42,48 48,64 58,54 C66,46 70,58 74,52"
        android:strokeWidth="2.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="56"
                android:endX="74"
                android:endY="52"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M35,63 C44,57 52,69 62,60 C68,54 71,62 73,61"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="35"
                android:startY="63"
                android:endX="73"
                android:endY="61"
                android:type="linear">
                <item android:color="#FF4081" android:offset="0.0" />
                <item android:color="#FFAB00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing interactive star particle at top right of canvas -->
    <path
        android:pathData="M60,37 L62,33 L64,37 L68,39 L64,41 L62,45 L60,41 L56,39 Z"
        android:fillColor="#00E5FF" />

    <path
        android:pathData="M44,45 L45,43 L46,45 L48,46 L46,47 L45,49 L44,47 L42,46 Z"
        android:fillColor="#FFD54F" />

    <!-- Touch interactive pulse ripple ring -->
    <path
        android:pathData="M62,39 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeWidth="1.2"
        android:strokeColor="#5000E5FF"
        android:fillColor="#00000000" />
</vector>
